{
  "name": "kiro-company-brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "pnpm -r --filter './packages/**' build && next build",
    "typecheck": "pnpm -r --filter './packages/**' typecheck && tsc --noEmit --pretty false",
    "test": "pnpm -r --filter './packages/**' build && vitest run && pnpm -r --filter './packages/**' test"
  },
  "dependencies": {
    "@kiro/senior-shared": "workspace:*",
    "@tailwindcss/postcss": "^4.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.31.0",
    "lucide-react": "^0.562.0",
    "next": "^16.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "node-gyp": "^12.3.0",
    "picomatch": "^4.0.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp"
    ]
  }
}
